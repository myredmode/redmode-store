rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /admins/{adminId} {
      allow read, write: if true;
    }

    match /products/{productId} {
      allow read, write: if true;
    }

    match /categories/{categoryId} {
      allow read, write: if true;
    }

    match /banners/{bannerId} {
      allow read, write: if true;
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }

    match /blogs/{blogId} {
      allow read, write: if true;
    }

    match /coupons/{couponId} {
      allow read, write: if true;
    }

    match /analytics_events/{eventId} {
      allow read, write: if true;
    }

    match /analytics_categories/{categoryId} {
      allow read, write: if true;
    }

    match /analytics_products/{productId} {
      allow read, write: if true;
    }

    match /_connection_test/{testId} {
      allow read, write: if true;
    }

    // Security Audit Log: Append-only immutable collection for critical admin action tracking
    match /AuditLog/{logId} {
      allow read: if isValidId(logId);
      allow create: if isValidId(logId) && request.resource.data.keys().hasAll(['id', 'action', 'entity', 'entityId', 'timestamp']);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
