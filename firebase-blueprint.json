{
  "entities": {
    "AdminUser": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "email": { "type": "string", "format": "email" },
        "mobile": { "type": "string", "minLength": 10, "maxLength": 20 },
        "role": { "type": "string", "enum": ["Super Admin", "Listing + Label Admin", "Label Admin"] },
        "status": { "type": "string", "enum": ["active", "disabled"] },
        "lastLogin": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "role", "status"]
    },
    "Product": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "mainImage": { "type": "string" }
      },
      "required": ["id", "name", "price"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": "AdminUser",
      "description": "Registered administrators and staff members"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Catalog products and updated listings"
    }
  }
}
